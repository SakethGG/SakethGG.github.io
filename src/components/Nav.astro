---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/notes/', label: 'Notes' },
  { href: '/essays/', label: 'Essays' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap-wide bar">
    <a href="/" class="plain wordmark">
      <span class="glow-dot mark" aria-hidden="true"></span>
      closed loop<span class="dot">.</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => (
          <li>
            <a class:list={['plain nav-link', { active: isActive(l.href) }]} href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    flex-wrap: wrap;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .mark {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }
  .dot {
    color: var(--accent);
  }
  nav {
    flex: 1;
    min-width: 0;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, text-shadow 0.15s ease;
  }
  .nav-link:hover {
    color: var(--accent);
    text-shadow: 0 0 8px var(--glow);
  }
  .nav-link.active {
    color: var(--fg);
    border-bottom: 2px solid var(--accent);
  }
</style>
