---
interface Props {
  href: string;
  title: string;
  meta?: string;
  summary?: string;
  tags?: string[];
  pill?: string;
  image?: string;
}

const { href, title, meta, summary, tags = [], pill, image } = Astro.props;
---

<a class="plain card" href={href}>
  {image && <img class="card-image" src={image} alt="" loading="lazy" />}
  <div class="card-body">
    <div class="card-top">
      {pill && <span class="pill">{pill}</span>}
      {meta && <span class="muted mono meta">{meta}</span>}
    </div>
    <h3 class="card-title">{title}</h3>
    {summary && <p class="muted card-summary">{summary}</p>}
    {tags.length > 0 && (
      <div class="tag-row">
        {tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
    )}
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--border);
  }
  .card-image {
    flex-shrink: 0;
    width: 7rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .card-body {
    min-width: 0;
    flex: 1;
  }
  @media (max-width: 480px) {
    .card {
      flex-direction: column;
    }
    .card-image {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
  .card:hover .card-title {
    color: var(--accent);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }
  .meta {
    font-size: 0.78rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 0.3rem;
    transition: color 0.15s ease;
  }
  .card-summary {
    margin: 0;
    font-size: 0.95rem;
  }
  .tag-row {
    margin-top: 0.6rem;
    margin-bottom: 0;
  }
</style>
