---
interface Item {
  href: string;
  title: string;
  date: Date;
  summary?: string;
}
interface Props {
  items: Item[];
}

const { items } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

{items.length === 0 && <p class="muted">Nothing here yet.</p>}
<ul class="list">
  {items.map((i) => (
    <li>
      <a class="plain row" href={i.href}>
        <span class="date mono">{fmt(i.date)}</span>
        <span class="text">
          <span class="title">{i.title}</span>
          {i.summary && <span class="summary muted">{i.summary}</span>}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .row {
    display: flex;
    gap: 1.5rem;
    padding: 1.1rem 0;
    text-decoration: none;
  }
  .date {
    flex: 0 0 5.5rem;
    font-size: 0.8rem;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .row:hover .title {
    color: var(--accent);
  }
  .summary {
    font-size: 0.95rem;
  }
  @media (max-width: 480px) {
    .row {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
