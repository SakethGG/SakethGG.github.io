---
interface Item {
  href: string;
  title: string;
  date: Date;
}
interface Props {
  items: Item[];
}

const { items } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

{items.length === 0 && <p class="muted">Nothing here yet.</p>}
<ul class="list">
  {items.map((i) => (
    <li>
      <span class="date muted">{fmt(i.date)}</span>
      <a href={i.href}>{i.title}</a>
    </li>
  ))}
</ul>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--border);
  }
  .date {
    flex: 0 0 6.5rem;
    font-size: 0.95rem;
  }
  @media (max-width: 480px) {
    .list li {
      flex-direction: column;
      gap: 0.1rem;
    }
  }
</style>
