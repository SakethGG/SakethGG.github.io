---
interface Item {
  href: string;
  title: string;
  date: Date;
}
interface Props {
  items: Item[];
}

const { items } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

{items.length === 0 && <p class="muted">Nothing here yet.</p>}
<ul class="list">
  {items.map((i) => (
    <li>
      <a class="title" href={i.href}>{i.title}</a>
      <span class="leader" aria-hidden="true"></span>
      <span class="date muted">{fmt(i.date)}</span>
    </li>
  ))}
</ul>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0;
    padding: 0.5rem 0;
  }
  .title {
    color: var(--fg);
    font-weight: 500;
  }
  .title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--muted);
    transform: translateY(-0.25em);
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .leader {
      display: none;
    }
    .list li {
      flex-direction: column-reverse;
      gap: 0;
    }
  }
</style>
