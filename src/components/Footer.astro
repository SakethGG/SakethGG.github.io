---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap-wide bar">
    <p class="muted">&copy; {year} Saketh Vegesna</p>
    <p class="muted"><a href="/contact/">Contact</a></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    padding-top: 1.25rem;
    padding-bottom: 1.5rem;
    font-size: 0.9rem;
  }
  p {
    margin: 0;
  }
</style>
