---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('reading', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const books = all.filter((r) => r.data.kind === 'book');
const papers = all.filter((r) => r.data.kind === 'paper');

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const stars = (n?: number) => (n ? '★'.repeat(n) + '☆'.repeat(5 - n) : '');
---

<BaseLayout title="Reading" description="Books and papers, with my own takeaway rather than the jacket copy.">
  <header class="page-head">
    <h1>Reading</h1>
    <p class="muted">Short log. My own summary of why it mattered, not the abstract.</p>
  </header>

  <section>
    <h2>Books</h2>
    {books.length === 0 && <p class="muted">Nothing here yet.</p>}
    <ul class="log">
      {books.map((b) => (
        <li>
          <a class="plain" href={`/reading/${b.id}/`}>
            <div class="row">
              <span class="title">{b.data.title}</span>
              {b.data.rating && <span class="rating accent">{stars(b.data.rating)}</span>}
            </div>
            <div class="row muted small">
              <span>{b.data.author}</span>
              <span class="mono">{fmt(b.data.date)}</span>
            </div>
            <p class="takeaway">{b.data.takeaway}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Papers</h2>
    {papers.length === 0 && <p class="muted">Nothing here yet.</p>}
    <ul class="log">
      {papers.map((p) => (
        <li>
          <a class="plain" href={`/reading/${p.id}/`}>
            <div class="row">
              <span class="title">{p.data.title}</span>
            </div>
            <div class="row muted small">
              <span>{p.data.author}</span>
              <span class="mono">{fmt(p.data.date)}</span>
            </div>
            <p class="takeaway">{p.data.takeaway}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2rem;
  }
  .log {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .log li {
    border-bottom: 1px solid var(--border);
  }
  .log a {
    display: block;
    padding: 1.1rem 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .log a:hover .title {
    color: var(--accent);
  }
  .small {
    font-size: 0.8rem;
    margin-top: 0.15rem;
  }
  .takeaway {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }
  .rating {
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>
