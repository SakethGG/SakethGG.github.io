---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimpleList from '../../components/SimpleList.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const items = entries.map((e) => ({
  href: `/notes/${e.id}/`,
  title: e.data.title,
  date: e.data.date,
}));
---

<BaseLayout title="Notes" description="Short, informal write-ups and thoughts." wide={false}>
  <h2 class="head">Notes</h2>
  <p class="muted intro">This is the low-friction pile: loose thoughts and half-formed ideas, not polished essays. Each one is marked <span class="evergreen">evergreen</span> (revised as I learn more) or dated (a snapshot of what I thought at the time).</p>
  <SimpleList items={items} />
</BaseLayout>

<style>
  .intro {
    margin-bottom: 1.5rem;
  }
  .evergreen {
    background: #dce4b8;
    color: #333333;
    font-weight: 600;
    padding: 0.05em 0.35em;
    border-radius: 3px;
  }
  .head {
    margin: 0 0 1rem;
  }
</style>
