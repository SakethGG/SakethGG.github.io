---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const current = all.filter((p) => p.data.category === 'current');
const side = all.filter((p) => p.data.category === 'side');
const archive = all.filter((p) => p.data.category === 'archive');

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
const statusLabel = (s: string) => (s === 'shipped' ? 'completed' : s);
---

<BaseLayout
  title="Projects & Research"
  description="Current research, side projects, and an archive of paused or older work."
>
  <header class="page-head">
    <h1>Projects <span class="amp">&amp;</span> Research</h1>
    <p class="muted">
      Current research, side projects, and an archive of older or paused work.
    </p>
  </header>

  <section>
    <h2>Current Research</h2>
    {current.length === 0 && <p class="muted">Nothing here yet.</p>}
    {current.map((p) => (
      <EntryCard
        href={`/projects/${p.id}/`}
        title={p.data.title}
        meta={`${fmt(p.data.date)} · ${statusLabel(p.data.status)}`}
        summary={p.data.summary}
        tags={p.data.tags}
        image={p.data.cover}
      />
    ))}
  </section>

  <section>
    <h2>Side Projects</h2>
    {side.length === 0 && <p class="muted">Nothing here yet.</p>}
    {side.map((p) => (
      <EntryCard
        href={`/projects/${p.id}/`}
        title={p.data.title}
        meta={`${fmt(p.data.date)} · ${statusLabel(p.data.status)}`}
        summary={p.data.summary}
        tags={p.data.tags}
        image={p.data.cover}
      />
    ))}
  </section>

  <section>
    <a class="plain archive-link" href="/projects/archive/">
      <h2>Archive <span class="muted mono archive-count">{archive.length}</span></h2>
      <p class="muted small">Older or paused work, kept here so the front stays uncluttered.</p>
    </a>
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2rem;
  }
  .amp {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .small {
    font-size: 0.85rem;
    margin-top: -0.5rem;
  }
  .archive-link {
    display: block;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }
  .archive-link:hover {
    border-color: var(--accent);
  }
  .archive-link:hover h2 {
    color: var(--accent);
  }
  .archive-link h2 {
    margin: 0 0 0.3rem;
    transition: color 0.15s ease;
  }
  .archive-count {
    font-size: 0.85rem;
  }
</style>
