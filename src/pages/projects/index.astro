---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimpleList from '../../components/SimpleList.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const items = entries.map((e) => ({
  href: `/projects/${e.id}/`,
  title: e.data.title,
  date: e.data.date,
  summary: e.data.summary,
}));
---

<BaseLayout title="Projects" description="Things I've built." wide={false}>
  <h1>Projects</h1>
  <p class="muted intro">Things I've built.</p>
  <SimpleList items={items} />
</BaseLayout>

<style>
  .intro {
    margin-bottom: 2rem;
  }
</style>
