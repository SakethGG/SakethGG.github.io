---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimpleList from '../../components/SimpleList.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const items = entries.map((e) => ({
  href: `/essays/${e.id}/`,
  title: e.data.title,
  date: e.data.date,
}));
---

<BaseLayout title="Essays" description="Longer pieces, argued properly." wide={false}>
  <h2 class="head">Essays</h2>
  <SimpleList items={items} />
</BaseLayout>

<style>
  .head {
    margin: 0 0 1rem;
  }
</style>
