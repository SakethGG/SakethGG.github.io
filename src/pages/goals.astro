---
import BaseLayout from '../layouts/BaseLayout.astro';
import { goals } from '../data/goals';

const near = goals.filter((g) => g.horizon === 'near');
const long = goals.filter((g) => g.horizon === 'long');

const statusLabel: Record<string, string> = {
  done: 'Done',
  'in-progress': 'In progress',
  planned: 'Planned',
};
---

<BaseLayout title="Goals & Milestones" description="Near-term and long-term goals, so visitors see trajectory, not just a snapshot.">
  <header class="page-head">
    <h1>Goals &amp; Milestones</h1>
    <p class="muted">
      A mix of near-term work and the long-term thing it's all pointing at.
      Edit <code>src/data/goals.ts</code> directly to update this.
    </p>
  </header>

  <section>
    <h2>Near-term</h2>
    <table>
      <thead>
        <tr>
          <th>Goal</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        {near.map((g) => (
          <tr>
            <td>
              {g.goal}
              {g.note && <div class="muted note">{g.note}</div>}
            </td>
            <td class={`status status-${g.status.replace('-', '')}`}>{statusLabel[g.status]}</td>
            <td class="mono">{g.date}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section>
    <h2>Long-term</h2>
    <table>
      <thead>
        <tr>
          <th>Goal</th>
          <th>Status</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        {long.map((g) => (
          <tr>
            <td>
              {g.goal}
              {g.note && <div class="muted note">{g.note}</div>}
            </td>
            <td class={`status status-${g.status.replace('-', '')}`}>{statusLabel[g.status]}</td>
            <td class="mono">{g.date}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <blockquote class="quote">
    <p>
      "A human being should be able to change a diaper, plan an invasion, butcher a hog,
      conn a ship, design a building, write a sonnet, balance accounts, build a wall, set a
      bone, comfort the dying, take orders, give orders, cooperate, act alone, solve
      equations, analyze a new problem, pitch manure, program a computer, cook a tasty
      meal, fight efficiently, die gallantly. Specialization is for insects."
    </p>
    <cite>— Robert A. Heinlein</cite>
  </blockquote>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2rem;
  }
  .quote {
    margin: 5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .quote p {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 42rem;
    margin: 0 auto 0.6rem;
  }
  .quote cite {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-style: normal;
    color: var(--muted);
  }
  .note {
    font-size: 0.82rem;
    margin-top: 0.2rem;
  }
  .status {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .status-inprogress {
    color: var(--accent);
  }
  .status-done {
    color: var(--fg);
  }
  .status-planned {
    color: var(--muted);
  }
</style>
