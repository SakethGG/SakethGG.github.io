---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const count = async (name: 'projects' | 'notes' | 'essays') =>
  (await getCollection(name, ({ data }) => !data.draft)).length;

const sections = [
  { href: '/projects/', label: 'Projects', blurb: "Things I've built.", n: await count('projects') },
  { href: '/notes/', label: 'Notes', blurb: 'Short, informal write-ups.', n: await count('notes') },
  { href: '/essays/', label: 'Essays', blurb: 'Longer pieces.', n: await count('essays') },
];
---

<BaseLayout title="closed loop" wide={false}>
  <h1>Saketh Vegesna</h1>
  <p class="lede muted">I work on legged robots: control, planning, and the hardware that carries it out.</p>

  <ul class="sections">
    {sections.map((s) => (
      <li>
        <a class="plain section" href={s.href}>
          <span class="label">{s.label}</span>
          <span class="blurb muted">{s.blurb}</span>
          <span class="n mono muted">{s.n}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
    margin-bottom: 3rem;
  }
  .sections {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sections li {
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .sections li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .section {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.4rem 0;
    text-decoration: none;
  }
  .label {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    min-width: 8rem;
  }
  .blurb {
    flex: 1;
  }
  .section:hover .label {
    color: var(--accent);
  }
  @media (max-width: 480px) {
    .section {
      flex-wrap: wrap;
      gap: 0.3rem 1rem;
    }
    .blurb {
      flex-basis: 100%;
      order: 3;
    }
  }
</style>
